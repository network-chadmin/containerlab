hostname R9
!
service timestamps log datetime msec
service timestamps debug datetime msec
no ip domain-lookup
ipv6 unicast-routing
!
banner motd ^
##############################################
# Routing Playground - Large
# Node: R9
##############################################
^
!
line con 0
 logging synchronous
 exec-timeout 0
line vty 0 4
 logging synchronous
 exec-timeout 0
!
interface Ethernet0/0
 no cdp enable
!
interface Loopback0
 description Router-ID
 ip address 9.9.9.9 255.255.255.255
 ipv6 address 2001:db8:9:0::9/128
!
interface Loopback1
 ip address 10.9.0.1 255.255.255.0
 ipv6 address 2001:db8:9:1::1/64
!
interface Loopback2
 ip address 10.9.1.1 255.255.255.128
 ipv6 address 2001:db8:9:2::1/64
!
interface Loopback3
 ip address 10.9.1.129 255.255.255.192
 ipv6 address 2001:db8:9:3::1/64
!
interface Loopback4
 ip address 10.9.1.225 255.255.255.224
 ipv6 address 2001:db8:9:4::1/64
!
interface Ethernet0/1
 description Link to R1
 ip address 10.0.19.9 255.255.255.0
 ipv6 address 2001:db8:0:19::9/64
 no shutdown
!
interface Ethernet0/2
 description Link to R2
 ip address 10.0.29.9 255.255.255.0
 ipv6 address 2001:db8:0:29::9/64
 no shutdown
!
end
