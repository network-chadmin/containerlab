hostname R2
!
no ip domain-lookup
!
line con 0
 logging synchronous
 exec-timeout 0
line vty 0 4
 logging synchronous
 exec-timeout 0
!
interface Ethernet0/0
 no cdp enable
!
interface Ethernet0/1
 description to D1 Ethernet5
 ip address 10.0.0.6 255.255.255.252
 no shutdown
!
interface Ethernet0/2
 description to D2 Ethernet5
 ip address 10.0.0.14 255.255.255.252
 no shutdown
!
interface Ethernet0/3
 description to ISP1 Ethernet0/2
 ip address 203.0.113.5 255.255.255.252
 no shutdown
!
end
