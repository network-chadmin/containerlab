hostname R1
!
no ip domain-lookup
!
line con 0
 logging synchronous
 exec-timeout 0
line vty 0 4
 logging synchronous
 exec-timeout 0
!
interface Ethernet0/0
 no cdp enable
!
interface Ethernet0/1
 description to D1 Ethernet4
 ip address 10.0.0.2 255.255.255.252
 no shutdown
!
interface Ethernet0/2
 description to D2 Ethernet4
 ip address 10.0.0.10 255.255.255.252
 no shutdown
!
interface Ethernet0/3
 description to ISP1 Ethernet0/1
 ip address 203.0.113.1 255.255.255.252
 no shutdown
!
end
